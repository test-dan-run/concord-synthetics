# Where runs are written (default: ./runs)
SYNTHETICS_RUNS=./runs
# The platform repo (stack.py lives in <PLATFORM_DIR>/tools) and, optionally, its venv
PLATFORM_DIR=../../platform
PLATFORM_VENV=
# NSC Part 3 (holds SDM/ and SPEAKER_INFO_PART3.XLSX) and the derived reference clips
NSC_DIR=/home/user/code/datasets/NSC_PART3
NSC_REFS_DIR=/home/user/code/datasets/nsc-part3-refs
# Sound library: noise/ (stage 7 noise beds and events) and nonlexical/ (stage 4 laughs, coughs, breaths)
SOUND_LIBRARY_DIR=/home/user/code/datasets/sound-library
# aicore: localhost = published host ports
AI_HOST=localhost
# 1 = stack.py up --no-evict (refuse to stop other GPU services)
NO_EVICT=0
